#!/bin/bash
# Sign a macOS .app or .dmg in place using the same isolated-keychain flow as
# PSXRecomp Studio.

set -euo pipefail
IFS=$'\n\t'
export LC_ALL=C

PROGRAM_NAME="$(/usr/bin/basename "$0")"

usage() {
    cat <<USAGE
Usage:
  ./${PROGRAM_NAME} package.app|package.dmg certificate.pfx <password>

Signs the package in place. The signer:
  - normalizes the PFX with OpenSSL 3 and a generated ASCII password;
  - imports it into an isolated temporary keychain;
  - for .app bundles:
      * signs every nested Mach-O file, including Frameworks and MacOS contents;
      * signs nested code bundles inside-out;
      * signs the main executable and app with Hardened Runtime;
      * applies disable-library-validation, requests a secure timestamp, and
        verifies the final app with codesign --verify --deep --strict;
  - for .dmg disk images:
      * clears resource forks / extended attributes that block signing;
      * signs the disk image (with secure timestamp when enabled);
      * verifies the signature with codesign --verify.

Environment:
  PSXRECOMP_OPENSSL              Absolute path to OpenSSL 3 (optional).
  PSXRECOMP_SIGNER_NO_TIMESTAMP  Set to 1 only for offline/self-signed testing.
  PSXRECOMP_SIGNER_ADHOC_TEST    Set to 1 only for disposable smoke tests.
USAGE
}

log() {
    printf '%s: %s\n' "$PROGRAM_NAME" "$*"
}

fail() {
    printf '%s: error: %s\n' "$PROGRAM_NAME" "$*" >&2
    exit 1
}

if [[ "$(/usr/bin/uname -s)" != "Darwin" ]]; then
    fail "macOS is required."
fi

if [[ $# -ne 3 ]]; then
    usage >&2
    exit 2
fi

PACKAGE_INPUT=$1
CERT_INPUT=$2
PFX_PASSWORD=$3
shift 3

[[ -f "$CERT_INPUT" ]] || fail "Certificate not found: $CERT_INPUT"

PACKAGE_TYPE=""
if [[ "$PACKAGE_INPUT" == *.app ]]; then
    PACKAGE_TYPE="app"
    [[ -d "$PACKAGE_INPUT" ]] || fail "App bundle not found: $PACKAGE_INPUT"
    [[ -d "$PACKAGE_INPUT/Contents" ]] || fail "Invalid app bundle (missing Contents): $PACKAGE_INPUT"
    [[ -f "$PACKAGE_INPUT/Contents/Info.plist" ]] || fail "Invalid app bundle (missing Info.plist): $PACKAGE_INPUT"
    [[ -d "$PACKAGE_INPUT/Contents/MacOS" ]] || fail "Invalid app bundle (missing Contents/MacOS): $PACKAGE_INPUT"
elif [[ "$PACKAGE_INPUT" == *.dmg ]]; then
    PACKAGE_TYPE="dmg"
    [[ -f "$PACKAGE_INPUT" ]] || fail "Disk image not found: $PACKAGE_INPUT"
else
    fail "The package path must end in .app or .dmg: $PACKAGE_INPUT"
fi

canonical_path() {
    local input=$1
    local directory
    local base
    directory=$(cd -P "$(/usr/bin/dirname "$input")" && pwd)
    base=$(/usr/bin/basename "$input")
    printf '%s/%s\n' "$directory" "$base"
}

PACKAGE=$(canonical_path "$PACKAGE_INPUT")
CERTIFICATE=$(canonical_path "$CERT_INPUT")

for tool in /usr/bin/codesign /usr/bin/security /usr/bin/file \
            /usr/bin/find /usr/bin/grep /usr/bin/head /usr/bin/sed \
            /usr/bin/mktemp /usr/bin/uuidgen /usr/libexec/PlistBuddy \
            /bin/chmod /bin/rm /usr/bin/xattr; do
    [[ -x "$tool" ]] || fail "Required tool is unavailable: $tool"
done

find_openssl3() {
    local candidate
    local candidates=()
    if [[ -n "${PSXRECOMP_OPENSSL:-}" ]]; then
        candidates+=("$PSXRECOMP_OPENSSL")
    fi
    candidates+=(
        "/usr/local/opt/openssl@3/bin/openssl"
        "/opt/homebrew/opt/openssl@3/bin/openssl"
        "/usr/local/bin/openssl"
        "/opt/homebrew/bin/openssl"
        "/usr/local/Caskroom/miniconda/base/bin/openssl"
    )
    if command -v openssl >/dev/null 2>&1; then
        candidates+=("$(command -v openssl)")
    fi

    for candidate in "${candidates[@]}"; do
        [[ -x "$candidate" ]] || continue
        if "$candidate" version 2>/dev/null | /usr/bin/grep -q '^OpenSSL 3\.' &&
           "$candidate" pkcs12 -help 2>&1 | /usr/bin/grep -q -- '-legacy'; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

OPENSSL=$(find_openssl3) ||
    fail "OpenSSL 3 with pkcs12 -legacy support is required (brew install openssl@3)."

TMP_ROOT=${TMPDIR:-/tmp}
TMP_ROOT=${TMP_ROOT%/}
WORKSPACE=$(/usr/bin/mktemp -d "$TMP_ROOT/psxrecomp-signer.XXXXXX") ||
    fail "Could not create a temporary workspace."
KEYCHAIN="$WORKSPACE/signing.keychain-db"
SOURCE_PEM="$WORKSPACE/signing-source.pem"
NORMALIZED_P12="$WORKSPACE/signing-normalized.p12"
ENTITLEMENTS="$WORKSPACE/App.entitlements"
KEYCHAIN_PASSWORD="$(/usr/bin/uuidgen)$(/usr/bin/uuidgen)"
NORMALIZED_PASSWORD="$(/usr/bin/uuidgen)$(/usr/bin/uuidgen)"
KEYCHAIN_CREATED=0

destroy_keychain() {
    if [[ $KEYCHAIN_CREATED -eq 1 ]]; then
        /usr/bin/security delete-keychain "$KEYCHAIN" >/dev/null 2>&1
        KEYCHAIN_CREATED=0
    fi
}

cleanup() {
    local status=$?
    trap - EXIT HUP INT TERM
    set +e
    set +u
    unset PSXRECOMP_SIGNER_PFX_PASSWORD
    unset PSXRECOMP_SIGNER_NORMALIZED_PASSWORD
    PFX_PASSWORD=""
    NORMALIZED_PASSWORD=""
    KEYCHAIN_PASSWORD=""
    destroy_keychain
    /bin/chmod -R u+rwX "$WORKSPACE" >/dev/null 2>&1
    /bin/rm -rf "$WORKSPACE"
    exit "$status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

export PSXRECOMP_SIGNER_PFX_PASSWORD="$PFX_PASSWORD"
export PSXRECOMP_SIGNER_NORMALIZED_PASSWORD="$NORMALIZED_PASSWORD"
PFX_PASSWORD=""

log "validating and normalizing certificate"
if ! "$OPENSSL" pkcs12 -in "$CERTIFICATE" -nodes -out "$SOURCE_PEM" \
        -passin env:PSXRECOMP_SIGNER_PFX_PASSWORD \
        >"$WORKSPACE/openssl-extract.out" 2>"$WORKSPACE/openssl-extract.err"; then
    if ! "$OPENSSL" pkcs12 -legacy -in "$CERTIFICATE" -nodes -out "$SOURCE_PEM" \
            -passin env:PSXRECOMP_SIGNER_PFX_PASSWORD \
            >"$WORKSPACE/openssl-extract-legacy.out" \
            2>"$WORKSPACE/openssl-extract-legacy.err"; then
        cat "$WORKSPACE/openssl-extract.err" >&2
        cat "$WORKSPACE/openssl-extract-legacy.err" >&2
        fail "The PFX password was rejected or the certificate could not be read."
    fi
fi
/bin/chmod 600 "$SOURCE_PEM"

if ! "$OPENSSL" pkcs12 -legacy -export -in "$SOURCE_PEM" \
        -out "$NORMALIZED_P12" \
        -passout env:PSXRECOMP_SIGNER_NORMALIZED_PASSWORD \
        -name "PSXRecomp Signer" \
        >"$WORKSPACE/openssl-export.out" 2>"$WORKSPACE/openssl-export.err"; then
    cat "$WORKSPACE/openssl-export.err" >&2
    fail "The signing certificate could not be normalized for macOS Security."
fi
/bin/rm -f "$SOURCE_PEM"
unset PSXRECOMP_SIGNER_PFX_PASSWORD

log "creating isolated temporary keychain"
/usr/bin/security create-keychain -p "$KEYCHAIN_PASSWORD" "$KEYCHAIN"
KEYCHAIN_CREATED=1
/usr/bin/security set-keychain-settings -lut 21600 "$KEYCHAIN"
/usr/bin/security unlock-keychain -p "$KEYCHAIN_PASSWORD" "$KEYCHAIN"
/usr/bin/security import "$NORMALIZED_P12" -k "$KEYCHAIN" \
    -P "$NORMALIZED_PASSWORD" \
    -T /usr/bin/codesign -T /usr/bin/security
/usr/bin/security set-key-partition-list -S apple-tool:,apple: -s \
    -k "$KEYCHAIN_PASSWORD" "$KEYCHAIN" >/dev/null
/bin/rm -f "$NORMALIZED_P12"
unset PSXRECOMP_SIGNER_NORMALIZED_PASSWORD
NORMALIZED_PASSWORD=""

IDENTITY_OUTPUT=$(/usr/bin/security find-identity -v -p codesigning "$KEYCHAIN" 2>&1) ||
    fail "Could not inspect the imported code-signing identity."
IDENTITY_HASH=$(printf '%s\n' "$IDENTITY_OUTPUT" |
    /usr/bin/grep -Eo '[0-9A-Fa-f]{40}' | /usr/bin/head -n 1 || true)
IDENTITY_NAME=$(printf '%s\n' "$IDENTITY_OUTPUT" |
    /usr/bin/sed -n 's/.*"\(.*\)".*/\1/p' | /usr/bin/head -n 1)
if [[ -z "$IDENTITY_HASH" && "${PSXRECOMP_SIGNER_ADHOC_TEST:-0}" == "1" ]]; then
    IDENTITY_HASH="-"
    IDENTITY_NAME="ad-hoc smoke-test identity"
    log "warning: production PFX identity is invalid; using ad-hoc signing for the explicit smoke test"
fi
[[ -n "$IDENTITY_HASH" ]] || fail "The imported PFX contains no usable code-signing identity."
log "signing identity: ${IDENTITY_NAME:-$IDENTITY_HASH}"

TIMESTAMP_ENABLED=1
if [[ "${PSXRECOMP_SIGNER_NO_TIMESTAMP:-0}" == "1" ]]; then
    TIMESTAMP_ENABLED=0
    log "secure timestamp disabled by PSXRECOMP_SIGNER_NO_TIMESTAMP=1"
fi

sign_path() {
    local path=$1
    local label=$2
    local app_code=$3
    local arguments=(--force)
    if [[ $TIMESTAMP_ENABLED -eq 1 ]]; then
        arguments+=(--timestamp)
    fi
    if [[ "$IDENTITY_HASH" == "-" ]]; then
        arguments+=(--sign -)
    else
        arguments+=(--keychain "$KEYCHAIN" --sign "$IDENTITY_HASH")
    fi

    /usr/bin/codesign --remove-signature "$path" >/dev/null 2>&1 || true
    if [[ "$app_code" == "1" ]]; then
        arguments+=(--options runtime --entitlements "$ENTITLEMENTS")
    fi
    arguments+=("$path")
    log "signing $label"
    /usr/bin/codesign "${arguments[@]}"
}

if [[ "$PACKAGE_TYPE" == "app" ]]; then
    cat > "$ENTITLEMENTS" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>com.apple.security.cs.disable-library-validation</key><true/>
</dict></plist>
PLIST

    BUNDLE_EXECUTABLE=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' \
        "$PACKAGE/Contents/Info.plist" 2>/dev/null) ||
        fail "Info.plist does not contain CFBundleExecutable."
    MAIN_EXECUTABLE="$PACKAGE/Contents/MacOS/$BUNDLE_EXECUTABLE"
    [[ -f "$MAIN_EXECUTABLE" ]] || fail "Main executable not found: $MAIN_EXECUTABLE"
    [[ -x "$MAIN_EXECUTABLE" ]] || fail "Main executable is not executable: $MAIN_EXECUTABLE"

    is_macho() {
        /usr/bin/file -b "$1" 2>/dev/null | /usr/bin/grep -q 'Mach-O'
    }

    is_macho "$MAIN_EXECUTABLE" || fail "Main executable is not Mach-O: $MAIN_EXECUTABLE"

    # Removing the outer signature first prevents stale CodeResources data while
    # nested code is being replaced.
    /usr/bin/codesign --remove-signature "$PACKAGE" >/dev/null 2>&1 || true

    NESTED_MACHO=()
    NESTED_MACHO_COUNT=0
    while IFS= read -r -d '' path; do
        [[ "$path" == "$MAIN_EXECUTABLE" ]] && continue
        case "$path" in
            */Frameworks/*|*/MacOS/*|*.dylib) ;;
            *) continue ;;
        esac
        if is_macho "$path"; then
            NESTED_MACHO+=("$path")
            ((NESTED_MACHO_COUNT += 1))
        fi
    done < <(/usr/bin/find "$PACKAGE/Contents" -type f -print0)
    if ((NESTED_MACHO_COUNT > 0)); then
        for path in "${NESTED_MACHO[@]}"; do
            relative=${path#"$PACKAGE/"}
            sign_path "$path" "$relative" 0
        done
    fi

    NESTED_BUNDLES=()
    NESTED_BUNDLE_COUNT=0
    while IFS= read -r -d '' path; do
        bundle_has_macho=0
        if ((NESTED_MACHO_COUNT > 0)); then
            for binary in "${NESTED_MACHO[@]}"; do
                if [[ "$binary" == "$path/"* ]]; then
                    bundle_has_macho=1
                    break
                fi
            done
        fi
        if ((bundle_has_macho == 1)); then
            NESTED_BUNDLES+=("$path")
            ((NESTED_BUNDLE_COUNT += 1))
        fi
    done < <(/usr/bin/find "$PACKAGE/Contents" -depth -type d \
        \( -name '*.app' -o -name '*.xpc' -o -name '*.appex' \
           -o -name '*.bundle' -o -name '*.plugin' \) -print0)
    if ((NESTED_BUNDLE_COUNT > 0)); then
        for path in "${NESTED_BUNDLES[@]}"; do
            relative=${path#"$PACKAGE/"}
            sign_path "$path" "$relative" 0
        done
    fi

    sign_path "$MAIN_EXECUTABLE" "main executable" 1
    sign_path "$PACKAGE" "app bundle (pass 1)" 1

    log "verifying app bundle"
    /usr/bin/codesign --verify --deep --strict --verbose=4 "$PACKAGE"

    # Match Studio's final-seal pass after all nested content is known-good.
    sign_path "$PACKAGE" "app bundle (final seal)" 1
    log "removing temporary keychain before final verification"
    destroy_keychain
    /usr/bin/codesign --verify --deep --strict --verbose=4 "$PACKAGE"

    log "keychain-independent signature verified: $PACKAGE"
else
    # .dmg path: simple outer signature (contents should already be signed).
    # Clear resource forks / Finder info that often prevent codesign of DMGs.
    log "clearing extended attributes on disk image"
    /usr/bin/xattr -cr "$PACKAGE" >/dev/null 2>&1 || true

    /usr/bin/codesign --remove-signature "$PACKAGE" >/dev/null 2>&1 || true

    # Derive a reasonable code-signing identifier (required/recommended for DMGs).
    # Use a stable reverse-DNS style based on the filename so it stays unique per product.
    DMG_BASENAME=$(/usr/bin/basename "$PACKAGE" .dmg)
    # Sanitize for identifier (alphanumeric + dots/hyphens)
    DMG_ID=$(printf '%s' "$DMG_BASENAME" | /usr/bin/sed -E 's/[^A-Za-z0-9.-]+/./g; s/^\.+//; s/\.+$//')
    if [[ -z "$DMG_ID" ]]; then
        DMG_ID="disk-image"
    fi
    IDENTIFIER="com.cybertwip.dmg.${DMG_ID}"

    arguments=(--force)
    if [[ $TIMESTAMP_ENABLED -eq 1 ]]; then
        arguments+=(--timestamp)
    fi
    if [[ "$IDENTITY_HASH" == "-" ]]; then
        arguments+=(--sign -)
    else
        arguments+=(--keychain "$KEYCHAIN" --sign "$IDENTITY_HASH")
    fi
    # Identifier is recommended by Apple for disk images.
    arguments+=(--identifier "$IDENTIFIER")
    arguments+=("$PACKAGE")

    log "signing disk image ($IDENTIFIER)"
    /usr/bin/codesign "${arguments[@]}"

    log "removing temporary keychain before final verification"
    destroy_keychain
    log "verifying disk image"
    /usr/bin/codesign --verify --verbose=4 "$PACKAGE"

    log "keychain-independent signature verified: $PACKAGE"
fi
