// <thread> for Virtua guests.
//
// libc++ in the Virtua SDK is configured with _LIBCPP_HAS_THREADS 0, and that is
// the right call: a .virtua image is one process with one thread, so std::thread
// has nothing to schedule. But the whole `namespace this_thread` block in
// libc++'s <thread> sits inside that same `#if _LIBCPP_HAS_THREADS`, and it
// takes std::this_thread::sleep_for down with it -- which has nothing to do with
// having threads. Pausing is what a single-threaded frame loop does most.
//
// The result was that every port arriving on MVII discovered the gap and filled
// it privately: see sleepFor() in axmol's Application-virtua.cpp, which exists
// only because `std::this_thread::sleep_for(waitDuration)` two lines away in the
// Linux backend does not compile here. Worse, code that did somehow reach a
// declaration got a wait that never happened, which reads as a frame loop
// spinning at 100% for no visible reason.
//
// So: this header sits ahead of libc++'s <thread> on the include path (R-Dash
// exports its own directory PUBLIC), forwards to it for everything libc++ does
// provide, and supplies the waiting half itself. Sleeps land on nanosleep(),
// which is Dash's, which is MVII's sys_sleep_until_us -- the same park the
// scheduler wakes against, so an idle guest hands its slice back rather than
// burning it.
//
// Three suppliers can own std::this_thread, and exactly one must: the POSIX
// shim (virtua_cpp_thread_shim.h, pthread-backed, force-included on arm and
// riscv64), libc++ itself when threads are on, and this file otherwise. The
// order below picks one. Nothing here is conditional on the architecture -- if
// a future SDK turns threads on, _LIBCPP_HAS_THREADS becomes 1 and the whole
// shim compiles to nothing.

#ifndef VIRTUA_DASH_THREAD_SHIM
#define VIRTUA_DASH_THREAD_SHIM

#if defined(__cplusplus)

// <__config> first, on its own, because it is what says whether there is
// anything to forward to. Deliberately not #include_next <thread> in the
// threadless case: with _LIBCPP_HAS_THREADS 0 that file is one big #if and
// defines nothing, but it still pulls <functional> -> <vector> -> <locale>,
// and <locale> does not compile for armv7a-none-eabi (no rune table for this
// platform). Including it would trade a missing sleep_for for a header that
// cannot be included at all.
#include <__config>

// Before deciding anything: the POSIX shim may already own this. It defines
// std::this_thread -- along with std::thread, mutex and condition_variable --
// over pthreads, and PowerEngine force-includes it into every C++ translation
// unit on arm and riscv64. Its own gate (MINOS_VIRTUA_USERLAND) makes this
// include free when it does not apply, so asking the file itself is better
// than re-testing its condition here and drifting from it later.
//
// Standing down matters more than it looks. The shim's this_thread is in
// namespace std; the one below is in std::__1, which is inline -- so they are
// not two definitions of different names, they are two candidates for
// `std::this_thread`, and every use site becomes ambiguous rather than
// redefined. That is the same reason CMakeLists.txt does not force-include the
// shim for x86_64, where libc++ has the real thing.
#if __has_include(<virtua_cpp_thread_shim.h>)
#  include <virtua_cpp_thread_shim.h>
#endif

#if defined(MVII_POSIX_SHIM_HAS_STD_THIS_THREAD)

// The shim owns std::this_thread here; nothing to add. Its sleep_for is the
// same nanosleep() call as below, so the waiting half is covered either way.

#elif defined(_LIBCPP_VERSION) && defined(_LIBCPP_HAS_THREADS) && !_LIBCPP_HAS_THREADS

// The three pieces of <chrono> this needs, and not <chrono> itself. At
// -std=c++20 the umbrella header pulls the calendar formatters
// (__chrono/formatter.h -> __chrono/ostream.h -> <format> -> __locale), and
// __locale is the same file that has no rune table for armv7a-none-eabi. These
// are the locale-free leaves: duration, time_point, and the clock to measure a
// deadline against.
#include <__chrono/duration.h>
#include <__chrono/steady_clock.h>
#include <__chrono/time_point.h>
#include <cerrno>
#include <time.h>

// <sched.h> is the POSIX shim's, not the sysroot's, so a guest that links Dash
// without adding virtua/posix-shim/include to its path -- which is legal, and
// which the SDK's own <time.h> does not require -- would fail to include this
// header at all. Declare the one function instead. Signature matched to
// posix-shim/include/sched.h exactly, noexcept included (that is, absent):
// under C++17 an exception specification is part of the type, so adding one
// here would clash with the shim wherever both are visible.
#if __has_include(<sched.h>)
#  include <sched.h>
#else
extern "C" int sched_yield(void);
#endif

_LIBCPP_BEGIN_NAMESPACE_STD

namespace this_thread {

// The one that does the work. libc++'s own pthread backend is
// `while (nanosleep(&ts, &ts) == -1 && errno == EINTR);` and this matches it,
// remainder feedback included -- Dash's nanosleep fills rem when it returns
// early, which it now can.
inline _LIBCPP_HIDE_FROM_ABI void sleep_for(const chrono::nanoseconds& __ns) {
    if (__ns <= chrono::nanoseconds::zero()) return;

    // tv_sec is 32-bit on armv7. Anything past its range is a caller asking to
    // wait longer than the machine will be powered on; cap rather than wrap.
    typedef decltype(::timespec{}.tv_sec) __sec_t;
    const long long __total = static_cast<long long>(__ns.count());
    long long __secs = __total / 1000000000LL;
    const long long __max_secs =
        static_cast<long long>((~static_cast<unsigned long long>(0)) >>
                               (65 - sizeof(__sec_t) * 8));
    if (__secs > __max_secs) __secs = __max_secs;

    ::timespec __ts;
    __ts.tv_sec = static_cast<__sec_t>(__secs);
    __ts.tv_nsec = static_cast<long>(__total % 1000000000LL);
    while (::nanosleep(&__ts, &__ts) == -1 && errno == EINTR) {
    }
}

template <class _Rep, class _Period>
inline _LIBCPP_HIDE_FROM_ABI void sleep_for(const chrono::duration<_Rep, _Period>& __d) {
    if (__d <= chrono::duration<_Rep, _Period>::zero()) return;
    // Round up, the same way libc++ does: a duration that truncates to zero
    // nanoseconds is still a request to wait.
    chrono::nanoseconds __ns = chrono::duration_cast<chrono::nanoseconds>(__d);
    if (__ns < __d) ++__ns;
    this_thread::sleep_for(__ns);
}

// steady_clock is the one clock a deadline can be subtracted from directly:
// it cannot jump, so one read is enough and the general loop below is waste.
// Guarded because libc++ only declares it when the platform has a monotonic
// clock -- MVII does, but the shim should not be what breaks if that changes.
#if _LIBCPP_HAS_MONOTONIC_CLOCK
template <class _Duration>
inline _LIBCPP_HIDE_FROM_ABI void
sleep_until(const chrono::time_point<chrono::steady_clock, _Duration>& __t) {
    this_thread::sleep_for(__t - chrono::steady_clock::now());
}
#endif

// The general form re-reads its own clock rather than converting once, because
// a system_clock deadline and a steady_clock one do not share an epoch here.
template <class _Clock, class _Duration>
inline _LIBCPP_HIDE_FROM_ABI void sleep_until(const chrono::time_point<_Clock, _Duration>& __t) {
    for (typename _Clock::time_point __now = _Clock::now(); __now < __t; __now = _Clock::now()) {
        this_thread::sleep_for(chrono::duration_cast<chrono::nanoseconds>(__t - __now));
    }
}

// One runnable context, so yielding is a scheduler round: it hands the rest of
// this slice back to MVII and returns when the guest is next picked.
inline _LIBCPP_HIDE_FROM_ABI void yield() _NOEXCEPT { ::sched_yield(); }

// There is exactly one thread, and it is always this one. Reported as a real id
// so that code logging or comparing ids still behaves.
struct __virtua_thread_id {
    _LIBCPP_HIDE_FROM_ABI friend bool operator==(__virtua_thread_id, __virtua_thread_id) { return true; }
    _LIBCPP_HIDE_FROM_ABI friend bool operator!=(__virtua_thread_id, __virtua_thread_id) { return false; }
    _LIBCPP_HIDE_FROM_ABI friend bool operator<(__virtua_thread_id, __virtua_thread_id) { return false; }
};

inline _LIBCPP_HIDE_FROM_ABI __virtua_thread_id get_id() _NOEXCEPT { return __virtua_thread_id(); }

}  // namespace this_thread

_LIBCPP_END_NAMESPACE_STD

#elif __has_include_next(<thread>)

// Threads are configured on, so libc++ owns all of this.
#include_next <thread>

#endif  // shim / libc++ without threads / libc++ with threads

#endif  // __cplusplus

#endif  // VIRTUA_DASH_THREAD_SHIM
